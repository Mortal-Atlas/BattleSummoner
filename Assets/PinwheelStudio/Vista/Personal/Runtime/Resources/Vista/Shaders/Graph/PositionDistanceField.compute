#pragma exclude_renderers gles3
#pragma kernel GenerateRaw
#pragma kernel FindRange
#pragma kernel Normalize

#include "../Includes/ShaderIncludes.hlsl"
#include COMMON_DATA_TYPES_HLSL

StructuredBuffer<float> _Positions;
RWTexture2D<float> _NormalizedOutput;
RWTexture2D<float> _RawOutput;
float2 _Resolution;
float2 _WorldSize;
int _SampleCount;
int _GeometryMode;
int _Closed;
int _Profile;
float _Range;
RWStructuredBuffer<uint> _AutoRange;
int _AutoRangeEnabled;

#define PROFILE_INSIDE_ONLY 0
#define PROFILE_INSIDE_OUTSIDE 1
#define PROFILE_EDGE_DISTANCE 2

float DistanceToSegment(float2 queryPosition, float2 segmentStart, float2 segmentEnd)
{
    float2 edge = segmentEnd - segmentStart;
    float edgeLengthSquared = dot(edge, edge);
    float result = distance(queryPosition, segmentStart);
    if (edgeLengthSquared > 1e-12)
    {
        float t = saturate(dot(queryPosition - segmentStart, edge) / edgeLengthSquared);
        result = distance(queryPosition, segmentStart + t * edge);
    }
    return result;
}

void EvaluateEdge(
    float2 queryPosition,
    float2 segmentStart,
    float2 segmentEnd,
    inout float minimumDistance,
    inout bool inside)
{
    minimumDistance = min(
        minimumDistance,
        DistanceToSegment(queryPosition, segmentStart, segmentEnd));

    bool crossesScanline =
        (segmentStart.y > queryPosition.y) != (segmentEnd.y > queryPosition.y);
    if (crossesScanline)
    {
        float intersectionX = segmentStart.x +
            (queryPosition.y - segmentStart.y) *
            (segmentEnd.x - segmentStart.x) /
            (segmentEnd.y - segmentStart.y);
        if (queryPosition.x < intersectionX)
            inside = !inside;
    }
}

[numthreads(8, 8, 1)]
void GenerateRaw(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution.x || id.y >= (uint)_Resolution.y)
        return;

    float2 uv = float2(id.xy) / (_Resolution - 1);
    float2 queryPosition = uv * _WorldSize;
    float minimumDistance = 3.402823466e+38;
    bool inside = false;
    int firstValid = -1;
    int previousValid = -1;
    int validCount = 0;

    for (int i = 0; i < _SampleCount; ++i)
    {
        PositionSample sample = LoadPositionSample(_Positions, i);
        if (sample.isValid <= 0)
            continue;

        float2 samplePosition = sample.position.xz * _WorldSize;
        if (_GeometryMode == 0)
        {
            minimumDistance = min(minimumDistance, distance(queryPosition, samplePosition));
        }
        else
        {
            if (firstValid < 0)
                firstValid = i;

            if (previousValid >= 0)
            {
                float2 previousPosition =
                    LoadPositionSample(_Positions, previousValid).position.xz * _WorldSize;
                EvaluateEdge(
                    queryPosition,
                    previousPosition,
                    samplePosition,
                    minimumDistance,
                    inside);
            }
            previousValid = i;
        }
        validCount++;
    }

    if (_GeometryMode == 1 && _Closed != 0 && validCount >= 3)
    {
        float2 lastPosition =
            LoadPositionSample(_Positions, previousValid).position.xz * _WorldSize;
        float2 firstPosition =
            LoadPositionSample(_Positions, firstValid).position.xz * _WorldSize;
        EvaluateEdge(
            queryPosition,
            lastPosition,
            firstPosition,
            minimumDistance,
            inside);
    }

    if (minimumDistance == 3.402823466e+38)
        minimumDistance = 0;
    if (_Profile != PROFILE_EDGE_DISTANCE && validCount >= 3 && !inside)
        minimumDistance = -minimumDistance;

    if (id.x == 0 && id.y == 0)
        _AutoRange[1] = validCount;
    _RawOutput[id.xy] = minimumDistance;
}

[numthreads(8, 8, 1)]
void FindRange(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution.x || id.y >= (uint)_Resolution.y)
        return;

    float usefulDistance = max(0, _RawOutput[id.xy]);
    InterlockedMax(_AutoRange[0], asuint(usefulDistance));
}

[numthreads(8, 8, 1)]
void Normalize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution.x || id.y >= (uint)_Resolution.y)
        return;

    float rawDistance = _RawOutput[id.xy];
    uint validCount = _AutoRange[1];
    int effectiveProfile = validCount >= 3 ? _Profile : PROFILE_EDGE_DISTANCE;
    float normalizationRange = _AutoRangeEnabled != 0
        ? asfloat(_AutoRange[0])
        : _Range;
    normalizationRange = max(0.01, normalizationRange);

    float normalizedDistance;
    if (effectiveProfile == PROFILE_INSIDE_OUTSIDE)
        normalizedDistance = saturate(0.5 + rawDistance / (2 * normalizationRange));
    else if (effectiveProfile == PROFILE_INSIDE_ONLY)
        normalizedDistance = saturate(rawDistance / normalizationRange);
    else
        normalizedDistance = saturate(rawDistance / normalizationRange);

    _NormalizedOutput[id.xy] = normalizedDistance;
}
