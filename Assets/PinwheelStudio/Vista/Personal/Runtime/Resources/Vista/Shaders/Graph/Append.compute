#pragma exclude_renderers gles3
#pragma kernel Main

#include "../Includes/CommonDataTypes.hlsl"

StructuredBuffer<float> _SrcBuffer;
int _BaseIndex;
int _InstanceCount;
int _DestOffset;

RWStructuredBuffer<float> _DestBuffer;

[numthreads(8, 1, 1)]
void Main(uint3 id: SV_DISPATCHTHREADID)
{
	int index = id.x + _BaseIndex;
	if (index >= _InstanceCount)
		return;

	PositionSample p = LoadPositionSample(_SrcBuffer, index);
	StorePositionSample(_DestBuffer, index + _DestOffset, p);
}
