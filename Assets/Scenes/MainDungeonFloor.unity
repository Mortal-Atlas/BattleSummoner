  - entityId: familiar_corvus
    displayName: Corvus
    subtitle: Scrying Arcane Raven
    entityType: 2
    arcana: 1
    arcanaTitle: THE MAGICIAN
    portraitSpriteName: Mockup_SocialPortrait_Corvus.png
    loreDescription: Inquisitive mystical bird linked to the Astral Weave. Obsessed
      with glittering gemstones, shiny trinkets, and arcane drafts.
    currentAffinity: 40
    socialLinkRank: 4
    currentMood: 0
    lovedGiftIds:
