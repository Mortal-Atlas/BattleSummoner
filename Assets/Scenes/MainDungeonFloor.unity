  m_Script: {fileID: 11500000, guid: 5a6e5f12682c3b3449e37f1f2cf10ded, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BattleSummoner.Social.TomodachiSocialLinkManager
  roster:
  - entityId: familiar_pygmy
    displayName: Pygmy Sprite
    subtitle: Gossamer Fairy Companion
    entityType: 2
    arcana: 17
    arcanaTitle: THE STAR
    portraitSpriteName: Mockup_SocialPortrait_Pygmy.png
    loreDescription: Cheerful tiny sprite with iridescent fairy wings and boundless
      curiosity. Loves sweet berry poke-puffs, warm bubble baths, and shiny ribbons.
    currentAffinity: 83
    socialLinkRank: 4
    currentMood: 0
    lovedGiftIds:
    - treat_berry
    - toy_ribbon
    - potion_elixir
    likedGiftIds:
    - treat_honey
    - toy_bell
    dislikedGiftIds:
    - blunt_rock
    hatedGiftIds:
    - slimy_ooze
    lovedGiftLine: '*Giggles and twirls with sparkling fairy dust!* My absolute favorite!
      Master is the best in the whole wide Spire!'
    likedGiftLine: '*Flutters gossamer wings happily* Ooh, what a lovely treat! Thank
      you, Master!'
    neutralGiftLine: '*Sniffs curiously* A sweet curiosity! Pygmy will keep it safe
      in our nest!'
    dislikedGiftLine: '*Pouts with crossed arms* Too heavy and dull! Sprites like
      sparkly things!'
    hatedGiftLine: '*Hides behind your shoulder shivering* Eeeeek! Keep that slimy
      thing away!'
    rankUpLine: Our hearts pulse with pure starlight! Pygmy grants thee the legendary
      Endure blessing!
    chatBranches: []
    positiveBuff:
      id: buff_pygmy
      title: Gossamer Ward
      isBuff: 1
      description: "+20% Familiar Attack Power & Survives lethal hits with 1 HP out
        of love (Pok\xE9mon Amie Sturdy)."
      xpMultiplier: 1
      shopBuyMultiplier: 1
      shopSellMultiplier: 1
      playerDefenseMultiplier: 1
      playerMoveSpeedMultiplier: 1
      summonAttackMultiplier: 1.2
      summonHpMultiplier: 1
      summonCooldownMultiplier: 1
      autoShieldThreshold: 0.2
    negativeDebuff:
      id: 
      title: 
      isBuff: 0
      description: 
      xpMultiplier: 1
      shopBuyMultiplier: 1
      shopSellMultiplier: 1
      playerDefenseMultiplier: 1
      playerMoveSpeedMultiplier: 1
      summonAttackMultiplier: 1
      summonHpMultiplier: 1
      summonCooldownMultiplier: 1
      autoShieldThreshold: 0
    careState:
      hunger: 100
      hydration: 100
      cleanliness: 100
      happiness: 100
      bonusAttack: 20
      bonusDefense: 10
      bonusMagic: 20
      bonusSpeed: 25
      affectionHearts: 3
      totalTimesFed: 1
      totalTimesBathed: 1
      totalPresentsReceived: 1
      totalPettings: 1
      favoriteFood: Berry Poke-Puff
      favoriteToy: Celestial Ribbon
      speciesDietDesc: Adores fresh Luminescent Berries, whipped pastry, and crystal
        dew.
  - entityId: npc_margo
    displayName: Margo
    subtitle: Royal Spire Archivist
    entityType: 1
    arcana: 2
    arcanaTitle: THE HIGH PRIESTESS
    portraitSpriteName: Mockup_PersonaPortrait_Margo.png
    loreDescription: Keeper of ancient Spire chronologies and arcane runes. Values
      scholarly texts, contemplative silence, and restorative elixirs.
    currentAffinity: 25
    socialLinkRank: 3
    currentMood: 1
    lovedGiftIds:
    - relic_whetstone
    - potion_elixir
    - cryptex
    likedGiftIds:
    - potion_amber
    - mat_ruby
    dislikedGiftIds:
    - weapon_bow
    - potion_crimson
    hatedGiftIds:
    - slimy_ooze
    - cursed_tome
    lovedGiftLine: Incredible... this artifact bears inscriptions from the First
      Era! I shall decipher its sacred wisdom immediately.
    likedGiftLine: Thank you, Wanderer. A thoughtful draught to illuminate the long
      hours of archival cataloging.
    neutralGiftLine: I accept this gesture. Every artifact in the Spire carries historical
      merit.
    dislikedGiftLine: Instruments of wanton bloodshed hold little allure for me,
      Wanderer. Please refrain.
    hatedGiftLine: Contaminated filth! Keep such blasphemous defilement far from
      my sacred library!
    rankUpLine: Thou art become the mirror of my deepest truth... The High Priestess
      casts her sacred benediction upon thy path.
    chatBranches:
    - promptDialogue: Wanderer... do you believe the Spire was constructed as a prison,
        or an instrument of transcendence?
      choiceOptionA: A temple of transcendence, unlocked through understanding.
      reactionDialogueA: Indeed. You possess an archivist's rare philosophical depth.
      affinityDeltaA: 12
      moodA: 0
      choiceOptionB: Just a blood-soaked dungeon to conquer for loot.
      reactionDialogueB: How utterly boorish. Your lack of wonder grieves me.
      affinityDeltaB: -10
      moodB: 3
    positiveBuff:
      id: buff_margo
